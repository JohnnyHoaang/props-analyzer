// Phase 1 subset of docs/DATABASE_SCHEMA.md — only what "browse players and
// completed game logs" needs. Injuries, lineups, advanced stats, features,
// predictions and saved analyses are added in the phases that need them
// (see docs/MVP_TASKS.md). Every model follows the AGENTS.md DB rule:
// id + createdAt + updatedAt, no hard deletes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Authentication is deferred (Phase 1 stubs a single fixed "current user" —
/// see AGENTS.md workflow notes). This table exists now because later
/// phases (e.g. Phase 8 saved analyses) need a stable userId to reference.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Team {
  id           String   @id @default(cuid())
  name         String
  abbreviation String   @unique
  conference   Conference
  division     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  players   Player[]
  homeGames Game[]   @relation("HomeTeam")
  awayGames Game[]   @relation("AwayTeam")

  @@map("teams")
}

model Player {
  id        String         @id @default(cuid())
  fullName  String
  position  PlayerPosition
  height    Int // inches
  weight    Int // pounds
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  gameStats PlayerGameStat[]

  @@index([teamId])
  @@map("players")
}

model Season {
  id        String   @id @default(cuid())
  label     String   @unique // e.g. "2025-26"
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games Game[]

  @@map("seasons")
}

model Game {
  id               String     @id @default(cuid())
  date             DateTime
  status           GameStatus @default(FINAL)
  gameType         GameType   @default(REGULAR_SEASON)
  homeScore        Int?
  awayScore        Int?
  overtimePeriods  Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id])

  homeTeamId String
  homeTeam   Team   @relation("HomeTeam", fields: [homeTeamId], references: [id])

  awayTeamId String
  awayTeam   Team   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  playerStats PlayerGameStat[]

  @@index([seasonId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([date])
  @@map("games")
}

/// One row per player per completed game. Phase 1 only ingests final box
/// scores via mock data; live in-game updates are explicitly out of scope
/// (see AGENTS.md).
model PlayerGameStat {
  id          String   @id @default(cuid())
  minutes     Int
  points      Int
  rebounds    Int
  assists     Int
  threePM     Int
  threePA     Int
  fgm         Int
  fga         Int
  ftm         Int
  fta         Int
  steals      Int
  blocks      Int
  turnovers   Int
  fouls       Int
  plusMinus   Int
  starter     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  @@unique([playerId, gameId])
  @@index([gameId])
  @@map("player_game_stats")
}

enum Conference {
  EASTERN
  WESTERN
}

enum PlayerPosition {
  PG
  SG
  SF
  PF
  C
}

enum GameStatus {
  SCHEDULED
  FINAL
  POSTPONED
}

enum GameType {
  REGULAR_SEASON
  PLAYOFFS
}
