// Phase 1 subset of docs/DATABASE_SCHEMA.md — only what "browse players and
// completed game logs" needs. Injuries, lineups, advanced stats, features,
// predictions and saved analyses are added in the phases that need them
// (see docs/MVP_TASKS.md). Every model follows the AGENTS.md DB rule:
// id + createdAt + updatedAt, no hard deletes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Authentication is deferred (Phase 1 stubs a single fixed "current user" —
/// see AGENTS.md workflow notes). This table exists now because later
/// phases (e.g. Phase 8 saved analyses) need a stable userId to reference.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Team {
  id           String   @id @default(cuid())
  name         String
  abbreviation String   @unique
  conference   Conference
  division     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  players   Player[]
  homeGames Game[]   @relation("HomeTeam")
  awayGames Game[]   @relation("AwayTeam")

  @@map("teams")
}

model Player {
  id        String         @id @default(cuid())
  fullName  String
  position  PlayerPosition
  height    Int // inches
  weight    Int // pounds
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  gameStats     PlayerGameStat[]
  injuryReports InjuryReport[]
  lineupReports LineupReport[]
  propLines     PropLine[]

  @@index([teamId])
  @@map("players")
}

model Season {
  id        String   @id @default(cuid())
  label     String   @unique // e.g. "2025-26"
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games Game[]

  @@map("seasons")
}

model Game {
  id               String     @id @default(cuid())
  date             DateTime
  status           GameStatus @default(FINAL)
  gameType         GameType   @default(REGULAR_SEASON)
  homeScore        Int?
  awayScore        Int?
  overtimePeriods  Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id])

  homeTeamId String
  homeTeam   Team   @relation("HomeTeam", fields: [homeTeamId], references: [id])

  awayTeamId String
  awayTeam   Team   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  playerStats PlayerGameStat[]

  @@index([seasonId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([date])
  @@map("games")
}

/// One row per player per completed game. Phase 1 only ingests final box
/// scores via mock data; live in-game updates are explicitly out of scope
/// (see AGENTS.md).
model PlayerGameStat {
  id          String   @id @default(cuid())
  minutes     Int
  points      Int
  rebounds    Int
  assists     Int
  threePM     Int
  threePA     Int
  fgm         Int
  fga         Int
  ftm         Int
  fta         Int
  steals      Int
  blocks      Int
  turnovers   Int
  fouls       Int
  plusMinus   Int
  starter     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  @@unique([playerId, gameId])
  @@index([gameId])
  @@map("player_game_stats")
}

/// A prop market for a player: the consensus line, both sides' American
/// odds, and a mock projection. The per-game series the UI charts is derived
/// at request time from PlayerGameStat (see PlayersService) rather than
/// stored here — this row is only the line/odds/projection. `line` uses .5
/// values so a game is never an exact push. `projection` is a placeholder
/// until the projection engine lands (a later phase, see docs/MVP_TASKS.md).
model PropLine {
  id         String   @id @default(cuid())
  statType   StatType
  line       Float
  overOdds   Int
  underOdds  Int
  projection Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, statType])
  @@index([playerId])
  @@map("prop_lines")
}

/// Player-level status feed, not tied to a specific game — matches
/// docs/DATABASE_SCHEMA.md. Never overwrite old reports: each update is a
/// new row, so the app can rebuild what was known at any point in time.
/// "Current" status is derived by querying the latest `reportedAt` per
/// player, same as LineupReport below.
model InjuryReport {
  id             String       @id @default(cuid())
  status         InjuryStatus
  description    String?
  reportedAt     DateTime
  expectedReturn DateTime?
  confirmed      Boolean      @default(false)
  source         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  @@index([playerId])
  @@index([reportedAt])
  @@map("injury_reports")
}

/// Each player's current expected role, independent of any single game
/// (see docs/MVP_TASKS.md decision: Phase 1 has no upcoming/SCHEDULED
/// games yet, so this can't reference one). Same append-only pattern as
/// InjuryReport.
model LineupReport {
  id           String              @id @default(cuid())
  role         LineupRole
  confirmation LineupConfirmation
  reportedAt   DateTime
  source       String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  @@index([playerId])
  @@index([reportedAt])
  @@map("lineup_reports")
}

enum Conference {
  EASTERN
  WESTERN
}

enum PlayerPosition {
  PG
  SG
  SF
  PF
  C
}

enum GameStatus {
  SCHEDULED
  FINAL
  POSTPONED
}

enum GameType {
  REGULAR_SEASON
  PLAYOFFS
}

enum InjuryStatus {
  OUT
  DOUBTFUL
  QUESTIONABLE
  PROBABLE
  ACTIVE
}

enum LineupRole {
  STARTER
  BENCH
  OUT
}

enum LineupConfirmation {
  EXPECTED
  CONFIRMED
}

enum StatType {
  POINTS
  REBOUNDS
  ASSISTS
  THREES_MADE
  STEALS
  BLOCKS
  TURNOVERS
  PTS_REB
  PTS_AST
  REB_AST
  PTS_REB_AST
}
