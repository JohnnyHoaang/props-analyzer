{
  "name": "@props-analyzer/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@props-analyzer/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mock-data": {
      "@props-analyzer/source": "./src/mock-data/index.ts",
      "types": "./dist/mock-data/index.d.ts",
      "import": "./dist/mock-data/index.js",
      "default": "./dist/mock-data/index.js"
    },
    "./supabase": {
      "@props-analyzer/source": "./src/supabase/index.ts",
      "types": "./dist/supabase/index.d.ts",
      "import": "./dist/supabase/index.js",
      "default": "./dist/supabase/index.js"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "tslib": "^2.3.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.1"
  },
  "scripts": {
    "db:export-mock-data": "tsx scripts/export-mock-data.ts",
    "db:load-bdl": "tsx scripts/load-bdl-data.ts",
    "db:add-missing-players": "tsx scripts/add-missing-players.ts",
    "db:backfill-stat-teams": "tsx scripts/backfill-stat-teams.ts",
    "db:seed-fake-props": "tsx scripts/seed-fake-props.ts",
    "db:gen-types": "supabase gen types typescript --local > src/supabase/types.ts",
    "db:migrate:up": "supabase db push",
    "db:migrate:reset": "supabase db reset"
  }
}
