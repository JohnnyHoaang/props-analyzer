{
  "name": "@props-analyzer/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@props-analyzer/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mock-data": {
      "@props-analyzer/source": "./src/mock-data/index.ts",
      "types": "./dist/mock-data/index.d.ts",
      "import": "./dist/mock-data/index.js",
      "default": "./dist/mock-data/index.js"
    }
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:export-mock-data": "tsx scripts/export-mock-data.ts"
  }
}
