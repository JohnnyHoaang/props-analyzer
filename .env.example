# Copy this file to .env and adjust values for your local environment.
# Never commit a real .env file.

# Data source for apps/api.
# - mock (default): reads packages/database/src/mock-data/mock-data.json — no Postgres required
# - postgres: uses Prisma + DATABASE_URL below
DATA_SOURCE=mock

# Optional override for the mock JSON file path (defaults to the repo copy above).
# MOCK_DATA_PATH="/absolute/path/to/mock-data.json"

# Postgres connection — only required when DATA_SOURCE=postgres.
# Matches the default credentials in docker-compose.yml.
# DATABASE_URL="postgresql://props_analyzer:props_analyzer@localhost:5432/props_analyzer?schema=public"

# balldontlie API key — required only for the `db:load-bdl` importer
# (loads real NBA teams and active players into Postgres). Get one at
# https://app.balldontlie.io.
# BDL_API_KEY="your-key-here"

# apps/api
API_PORT=3333

# apps/web
NEXT_PUBLIC_API_URL="http://localhost:3333"
