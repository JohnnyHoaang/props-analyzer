# Copy this file to .env and adjust values for your local environment.
# Never commit a real .env file.

# Postgres connection used by Prisma (packages/database) and apps/api.
# Matches the default credentials in docker-compose.yml.
DATABASE_URL="postgresql://props_analyzer:props_analyzer@localhost:5432/props_analyzer?schema=public"

# apps/api
API_PORT=3333

# apps/web
NEXT_PUBLIC_API_URL="http://localhost:3333"
