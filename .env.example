# Copy this file to .env and adjust values for your local environment.
# Never commit a real .env file.

# Data source for apps/api.
# - mock (default): reads packages/database/src/mock-data/mock-data.json — no DB required
# - supabase: reads via the Supabase service-role client (SUPABASE_* below)
DATA_SOURCE=mock

# Optional override for the mock JSON file path (defaults to the repo copy above).
# MOCK_DATA_PATH="/absolute/path/to/mock-data.json"

# balldontlie API key — required only for the `db:load-bdl` importer
# (loads real NBA teams and active players into Supabase). Get one at
# https://app.balldontlie.io.
# BDL_API_KEY="your-key-here"

# apps/api
API_PORT=3333

# apps/web
NEXT_PUBLIC_API_URL="http://localhost:3333"

# Supabase (server-side integration — apps/api only; never used by the frontend).
# For local dev, use the values printed by `pnpm exec supabase start`.
# The keys below are the default local-stack values (safe to commit — local only).
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH"
SUPABASE_SECRET_KEY="sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz"
SUPABASE_JWKS_URL="http://127.0.0.1:54321/auth/v1/.well-known/jwks.json"
